APP_ENV=development
APP_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
# Use this for local MySQL, or set DATABASE_URL to postgresql+psycopg://... for Supabase.
DATABASE_URL=mysql+pymysql://bugtracker:bugtracker@localhost:3306/bugtracker?charset=utf8mb4
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
DRIVE_SHARED_FOLDER_ID=1Wt5_0GQA7MvQzc0S7lCgW11r7S3hCk1V
GOOGLE_APPLICATION_CREDENTIALS=
ATTACHMENT_STORAGE=drive
# For a personal My Drive folder, run backend/authorize_google_drive.py instead.
# Keep its OAuth client and token JSON files in the root secrets/ directory.
RECORDING_RETENTION_DAYS=90
