APP_ENV=development
APP_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
# Prefer postgresql+psycopg:// and append sslmode=require. Percent-encode reserved password characters.
DATABASE_URL=
# Optional Supabase Auth project metadata (not used by the current password-based API).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_PORT=5173
BACKEND_PORT=8000
COOKIE_SECURE=false
DRIVE_SHARED_FOLDER_ID=1Wt5_0GQA7MvQzc0S7lCgW11r7S3hCk1V
# Path to the Google service-account JSON file on the backend machine.
GOOGLE_APPLICATION_CREDENTIALS=
RECORDING_RETENTION_DAYS=90
# Set only when running the demo seed command.
SEED_PASSWORD=
